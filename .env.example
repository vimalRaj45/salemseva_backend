# Port (Render sets this automatically)
PORT=8080

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/Shazu One?sslmode=require

# Razorpay Test / Live API Keys
RAZORPAY_KEY_ID=rzp_test_sample
RAZORPAY_KEY_SECRET=sample_secret

# Cloudflare Real-Time TURN / STUN (Optional for VoIP calling)
CLOUDFLARE_TURN_KEY_ID=sample_turn_id
CLOUDFLARE_TURN_API_TOKEN=sample_token

# ── Direct Business UPI QR Payment Gateway Configuration ──
# Dynamic Business UPI ID and Merchant Name (loaded from env, never hardcoded)
BUSINESS_UPI_ID=shazuone.pay@icici
BUSINESS_MERCHANT_NAME=Shazu One Home Services
# Optional aliases:
UPI_ID=shazuone.pay@icici
MERCHANT_NAME=Shazu One Home Services
PAYMENT_GATEWAY_MODE=DYNAMIC_QR

# ── Payment & Marketplace Routing ──
# (Platform fees and partner commission rates are centrally stored in the platform_settings table)
RAZORPAY_ROUTE_ENABLED=true

# ── Security settings (required) ────────────────────────────────────────
# Admin sign-in password. There is no default: /auth/login answers 503 until this is set.
ADMIN_PASSWORD=replace_with_a_long_random_value

# Shared secret for internal-only endpoints (wallet credit top-ups).
# Without it those routes are refused in production.
INTERNAL_API_KEY=replace_with_a_long_random_value

# Browser origins allowed by CORS, comma separated. Native app builds send no Origin
# header and stay allowed. Leave unset only for local development.
# CORS_ORIGINS=https://app.shazuone.in,https://shazuone.in

# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# Razorpay webhook signing secret. Falls back to RAZORPAY_KEY_SECRET when unset.
# RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_dashboard_value

# Local testing only, never in production:
#   PAYMENTS_ALLOW_UNSIGNED=1   accept payments with no Razorpay signature
#   ALLOW_OTP_ECHO=1            return the OTP in the /auth/otp/request response
#                               (already automatic when NODE_ENV=development; set it to
#                               opt a staging box in. Never set it in production)
#   ALLOW_BASE64_FALLBACK=1     store uploads as data URIs when S3 is unreachable

# ── Cloudflare Workers AI Support Agent Configuration ──
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_LLM_MODEL=@cf/mistral/mistral-7b-instruct-v0.1
CLOUDFLARE_STT_MODEL=@cf/openai/whisper

# ── Salem Operations Team Escalation Contacts ──
SALEM_OPS_PHONE=+918807099288
SALEM_OPS_WHATSAPP=+918807099288
SALEM_OPS_EMAIL=support@shazuone.com
SALEM_OPS_HOURS=8:00 AM - 9:00 PM IST (All 7 Days)
