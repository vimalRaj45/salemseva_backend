# Port (Render sets this automatically)
PORT=8080

# Neon PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/salemseva?sslmode=require

# Razorpay Test / Live API Keys
RAZORPAY_KEY_ID=rzp_test_sample
RAZORPAY_KEY_SECRET=sample_secret

# Cloudflare Real-Time TURN / STUN (Optional for VoIP calling)
CLOUDFLARE_TURN_KEY_ID=sample_turn_id
CLOUDFLARE_TURN_API_TOKEN=sample_token

# ── Dual-Sided Platform Commission & Payment Gateway Fee Matrix ──
# 1. Customer-side convenience / platform fee percentage (e.g. 2.0 = 2%)
CUSTOMER_PLATFORM_FEE_PERCENT=2.0

# 2. Payment gateway processing fee passed to customer (e.g. 2.0 = 2%)
PAYMENT_GATEWAY_FEE_PERCENT=2.0

# 3. Technician-side platform commission percentage deducted from work value (e.g. 5.0 = 5%)
PARTNER_COMMISSION_PERCENT=5.0

# 4. Razorpay Route Automated Marketplace Split (true/false)
RAZORPAY_ROUTE_ENABLED=true
